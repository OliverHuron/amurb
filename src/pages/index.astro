---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import HeroScroll from '../components/HeroScroll.astro';
import CiudadRecorrido from '../components/CiudadRecorrido.astro';
import Nosotros from '../components/Nosotros.astro';
import Marcas from '../components/Marcas.astro';
import Contacto from '../components/Contacto.astro';
import ScrollSuave from '../components/ScrollSuave.astro';

// Contenido estático: se prerenderiza y Cloudflare lo puede cachear en el edge.
export const prerender = true;
---

<Base
  title="AmUrb | Alumbrado público, mobiliario urbano y vialidad en Michoacán"
  description="AmUrb (Ambiental y Urbanística de Michoacán): alumbrado público y solar, parabuses, bolardos, brocales, coladeras, CCTV y tinacos. Suministro para gobierno, SEDENA y ciudades de México."
>
  <ScrollSuave />
  <Navbar />
  <main>
    <HeroScroll />

    <div id="contenido" class="relative z-10 bg-noche">
      <CiudadRecorrido />
      <Nosotros />
      <Marcas />
      <Contacto />
    </div>
  </main>
</Base>
