---
// Scroll suave con inercia (Lenis) sincronizado con GSAP ScrollTrigger.
// Convierte los saltos de la rueda del ratón en movimiento continuo; en táctil se deja el scroll nativo.
---

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lenis = new Lenis({
      lerp: 0.085,
      wheelMultiplier: 0.9,
      anchors: { offset: -64 },
    });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((tiempo) => lenis.raf(tiempo * 1000));
    gsap.ticker.lagSmoothing(0);
    window.scrollSuave = lenis;
  }

  // Medidor de fluidez para pruebas en dispositivos reales: https://amurb.com.mx/?fps
  if (new URLSearchParams(location.search).has('fps')) {
    const caja = document.createElement('div');
    caja.style.cssText =
      'position:fixed;left:8px;bottom:8px;z-index:99;padding:6px 10px;border-radius:8px;background:rgba(0,0,0,.75);color:#9fd36b;font:600 12px/1.4 monospace;pointer-events:none';
    document.body.append(caja);
    let previo = performance.now();
    let tiempos: number[] = [];
    let ultimo = previo;
    const medir = (t: number) => {
      tiempos.push(t - previo);
      previo = t;
      if (t - ultimo > 1000) {
        const orden = [...tiempos].sort((a, b) => a - b);
        const peor = orden[Math.floor(orden.length * 0.95)] ?? 0;
        const tirones = tiempos.filter((x) => x > 34).length;
        caja.textContent = `${tiempos.length} fps · p95 ${peor.toFixed(0)} ms · tirones ${tirones}`;
        tiempos = [];
        ultimo = t;
      }
      requestAnimationFrame(medir);
    };
    requestAnimationFrame(medir);
  }
</script>
