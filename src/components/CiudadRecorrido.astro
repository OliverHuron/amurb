---
// Recorrido por la ciudad con los productos AmUrb aplicados (render de Blender, scroll con GSAP).
import { RECORRIDO, paradas } from '../data/recorrido';
---

<section
  id="soluciones"
  data-recorrido
  data-total={RECORRIDO.frames}
  data-ruta-desktop={RECORRIDO.rutaDesktop}
  data-ruta-mobile={RECORRIDO.rutaMobile}
  data-extension={RECORRIDO.extension}
  aria-label="Soluciones aplicadas en la ciudad"
  class="relative h-[950vh] bg-black"
>
  <h2 class="sr-only">Soluciones de AmUrb aplicadas en la ciudad</h2>
  <div class="sticky top-0 h-svh overflow-hidden">
    <canvas data-recorrido-canvas aria-hidden="true" class="absolute inset-0 size-full"></canvas>
    <!-- Capas de legibilidad (como en el hero): abajo y a la izquierda, donde va el texto -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/85 via-black/35 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-full bg-gradient-to-r from-black/60 via-black/15 to-transparent sm:w-2/3"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-black/70 to-transparent"></div>

    <!-- Texto de cada escena, con la tipografía del hero: se activa la del rango de frames actual.
         Todas comparten la misma celda de la rejilla, alineadas abajo. -->
    <div class="absolute inset-x-0 bottom-0 z-10 mx-auto max-w-7xl px-5 pb-[10vh] sm:px-8">
      <div class="grid max-w-3xl items-end">
        {
          paradas.map((p) => (
            <article
              data-parada={p.id}
              data-desde={p.desde}
              data-hasta={p.hasta}
              data-activo="false"
              class="escena [grid-area:1/1] opacity-0 transition-opacity duration-300 data-[activo=true]:opacity-100 data-[activo=true]:duration-150"
              aria-hidden="true"
            >
              <p class="mb-4 font-display text-xs font-semibold tracking-[0.35em] text-ambar uppercase sm:mb-5 sm:text-sm">
                <span class="linea"><span style="--i:0">{p.etiqueta}</span></span>
              </p>
              <h3 class="font-display text-[clamp(2.2rem,5.4vw,4.5rem)] leading-[1.04] font-bold tracking-tight text-balance">
                <span class="linea"><span style="--i:1">{p.titulo}</span></span>
                <span class="linea"><span style="--i:2"><em class="texto-luz not-italic">{p.destacado}</em></span></span>
              </h3>
              <p class="mt-4 max-w-xl text-base text-white/80 sm:mt-6 sm:text-lg">
                <span class="linea"><span style="--i:3">{p.texto}</span></span>
              </p>
              {p.productos.length > 0 && (
                <div class="linea mt-5 pb-1">
                  <ul class="flex flex-wrap gap-2" style="--i:4">
                    {p.productos.map((nombre) => (
                      <li class="rounded-full border border-verde-luz/30 bg-black/30 px-3 py-1 text-xs font-medium text-verde-luz backdrop-blur-sm">{nombre}</li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <!-- Índice de escenas -->
    <nav aria-label="Escenas del recorrido" class="absolute top-28 right-5 z-10 hidden sm:right-8 lg:block">
      <ol class="flex flex-col items-end gap-3">
        {
          paradas.slice(1, -1).map((p) => (
            <li>
              <button
                type="button"
                data-ir-a={p.id}
                data-activo="false"
                class="group flex items-center gap-3 text-xs font-semibold tracking-wider text-white/55 uppercase [text-shadow:0_1px_8px_rgb(0_0_0/0.9)] transition-colors hover:text-white data-[activo=true]:text-white"
              >
                {p.etiqueta}
                <span class="block h-px w-5 bg-white/30 transition-all group-data-[activo=true]:w-10 group-data-[activo=true]:bg-ambar" />
              </button>
            </li>
          ))
        }
      </ol>
    </nav>

    <!-- Escena anterior / siguiente: avanzan a velocidad de reproducción y se detienen en la escena vecina -->
    <button
      type="button"
      data-escena-anterior
      aria-label="Escena anterior"
      class="flecha absolute top-1/2 left-3 z-20 -translate-y-1/2 sm:left-6"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button
      type="button"
      data-escena-siguiente
      aria-label="Escena siguiente"
      class="flecha absolute top-1/2 right-3 z-20 -translate-y-1/2 sm:right-6"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2"><path d="M9 5l7 7-7 7" /></svg>
    </button>

    <!-- Reproducir: recorre la ciudad solo, con pausas en cada producto (útil en equipos lentos) -->
    <div class="absolute top-24 left-5 z-20 sm:top-auto sm:right-8 sm:bottom-[10vh] sm:left-auto">
      <button
        type="button"
        data-reproducir
        data-estado="detenido"
        aria-label="Reproducir el recorrido"
        class="group flex items-center gap-3 text-left sm:flex-row-reverse sm:text-right"
      >
        <span class="boton-play relative grid size-14 shrink-0 place-items-center rounded-full bg-gradient-to-br from-ambar to-verde-luz text-noche shadow-[0_0_32px_-6px] shadow-ambar/70 transition-transform group-hover:scale-105 group-active:scale-95">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="icono-play ml-0.5 size-6 fill-current"><path d="M8 5.5v13a1 1 0 0 0 1.5.87l11-6.5a1 1 0 0 0 0-1.74l-11-6.5A1 1 0 0 0 8 5.5Z" /></svg>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="icono-pausa hidden size-6 fill-current"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
        </span>
        <span class="[text-shadow:0_1px_10px_rgb(0_0_0/0.9)]">
          <span data-reproducir-titulo class="block font-display text-sm font-semibold tracking-wide">Reproducir recorrido</span>
          <span data-reproducir-ayuda class="block text-xs text-white/70">o desliza para explorarlo a tu ritmo</span>
        </span>
      </button>
    </div>

    <div class="absolute inset-x-0 bottom-0 z-10 h-0.5 bg-white/10">
      <div data-recorrido-barra class="h-full w-full origin-left scale-x-0 bg-gradient-to-r from-ambar to-verde-luz"></div>
    </div>
  </div>
</section>

<style>
  /* Cada línea sube desde abajo de su máscara al activarse la escena (como el texto del hero) */
  .escena .linea {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .escena .linea > :global(*) {
    display: block;
    transform: translateY(115%);
    transition: transform 0.25s ease-in;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.45);
  }
  .escena .linea > :global(ul) {
    display: flex;
  }
  /* El degradado con background-clip no admite sombra: la pintaría encima del texto */
  .escena :global(.texto-luz) {
    text-shadow: none;
  }
  .escena[data-activo='true'] .linea > :global(*) {
    transform: none;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 70ms);
  }
  /* Flechas laterales: vidrio oscuro, borde con el degradado al pasar el mouse */
  .flecha {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: #fff;
    background: rgb(0 0 0 / 0.35);
    border: 1px solid rgb(255 255 255 / 0.18);
    backdrop-filter: blur(8px);
    transition: background-color 0.2s, border-color 0.2s, opacity 0.2s;
  }
  .flecha:hover {
    background: rgb(0 0 0 / 0.55);
    border-color: var(--color-ambar);
  }
  .flecha:disabled {
    opacity: 0.25;
    pointer-events: none;
  }
  /* Invitación a reproducir: un halo que late mientras está detenido */
  [data-estado='detenido'] .boton-play::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    border: 2px solid var(--color-ambar);
    opacity: 0;
    animation: halo 2.4s ease-out infinite;
  }
  @keyframes halo {
    0% {
      transform: scale(0.85);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }
  [data-estado='reproduciendo'] .icono-play {
    display: none;
  }
  [data-estado='reproduciendo'] .icono-pausa {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-estado='detenido'] .boton-play::after {
      animation: none;
    }
    .escena .linea > :global(*),
    .escena[data-activo='true'] .linea > :global(*) {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SecuenciaFrames } from '../lib/secuencia';
  import { ruedaSuave } from '../lib/rueda-suave';
  import { Reproductor } from '../lib/reproductor';

  gsap.registerPlugin(ScrollTrigger);

  const seccion = document.querySelector<HTMLElement>('[data-recorrido]')!;
  const canvas = seccion.querySelector<HTMLCanvasElement>('[data-recorrido-canvas]')!;
  const barra = seccion.querySelector<HTMLElement>('[data-recorrido-barra]')!;
  const tarjetas = [...seccion.querySelectorAll<HTMLElement>('[data-parada]')];
  const botones = [...seccion.querySelectorAll<HTMLButtonElement>('[data-ir-a]')];

  const total = Number(seccion.dataset.total);
  const movil = window.matchMedia('(max-width: 900px)').matches;
  const ruta = movil ? seccion.dataset.rutaMobile! : seccion.dataset.rutaDesktop!;
  // En pantallas verticales la imagen completa se ve con franjas negras (se funden con la página).
  const secuencia = new SecuenciaFrames(
    canvas,
    (i) => `${ruta}frame_${String(i + 1).padStart(4, '0')}.${seccion.dataset.extension}`,
    total,
    () => (window.innerWidth / window.innerHeight < 1 ? 'contain' : 'cover'),
  );

  // Pruebas de fluidez en dispositivos reales (/?fps)
  if (new URLSearchParams(location.search).has('fps')) (window as unknown as { secuenciaRecorrido: SecuenciaFrames }).secuenciaRecorrido = secuencia;

  // Carga diferida: empieza cuando la sección se acerca, para no competir con el hero.
  new IntersectionObserver(
    (entradas, obs) => {
      if (entradas.some((e) => e.isIntersecting)) {
        secuencia.cargar();
        obs.disconnect();
      }
    },
    { rootMargin: '150% 0px' },
  ).observe(seccion);

  let activa = '';
  function actualizar(frame: number) {
    const parada = tarjetas.find((t) => frame >= Number(t.dataset.desde) && frame <= Number(t.dataset.hasta));
    const id = parada?.dataset.parada ?? '';
    if (id === activa) return;
    activa = id;
    for (const t of tarjetas) {
      const on = t === parada;
      t.dataset.activo = String(on);
      t.setAttribute('aria-hidden', String(!on));
    }
    for (const b of botones) b.dataset.activo = String(b.dataset.irA === id);
  }

  const disparador = ScrollTrigger.create({
    trigger: seccion,
    start: 'top top',
    end: 'bottom bottom',
    scrub: 0.5,
    onUpdate: ({ progress }) => {
      const indice = progress * (total - 1);
      secuencia.dibujar(indice); // fraccionario: funde los dos frames vecinos
      barra.style.transform = `scaleX(${progress})`;
      actualizar(Math.round(indice) + 1);
    },
  });
  actualizar(1);

  // Rueda del mouse con pasos cortos y continuos dentro del recorrido (como las flechas del teclado).
  ruedaSuave({
    rango: () => ({ inicio: disparador.start, fin: disparador.end }),
    alMover: () => ScrollTrigger.update(),
  });

  // ---------- Reproducción automática y flechas ----------
  const centro = (t: HTMLElement) => (Number(t.dataset.desde) + Number(t.dataset.hasta)) / 2 - 1; // índice 0-based
  const aScroll = (indice: number) => disparador.start + (indice / (total - 1)) * (disparador.end - disparador.start);
  const botonPlay = seccion.querySelector<HTMLButtonElement>('[data-reproducir]')!;
  const tituloPlay = seccion.querySelector<HTMLElement>('[data-reproducir-titulo]')!;
  const ayudaPlay = seccion.querySelector<HTMLElement>('[data-reproducir-ayuda]')!;
  const anterior = seccion.querySelector<HTMLButtonElement>('[data-escena-anterior]')!;
  const siguiente = seccion.querySelector<HTMLButtonElement>('[data-escena-siguiente]')!;

  // Paradas de las flechas: inicio del mapa, el centro de cada escena de productos y el final.
  const conProductos = tarjetas.filter((t) => t.querySelector('ul')).map(centro);
  const escenas = [0, ...conProductos, total - 1];

  // Velocidad de reproducción y flechas según el equipo: más rápida con buen internet, RAM y procesador.
  // La red se mide con las propias descargas del recorrido (iPhone/Safari no informan red ni RAM).
  const LENTA = 42;
  function velocidadEquipo() {
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean; downlink?: number } };
    if (nav.connection?.saveData) return LENTA;
    const red = secuencia.mbps || nav.connection?.downlink || 0; // Mbps (downlink de Chrome llega topado a 10)
    const ram = nav.deviceMemory ?? 4; // GB (Chrome lo topa en 8; sin dato se asume un equipo medio)
    const nucleos = navigator.hardwareConcurrency || 4;
    if (red >= 20 && ram >= 8 && nucleos >= 8) return 90;
    if (red >= 8 && ram >= 4 && nucleos >= 4) return 65;
    return LENTA;
  }
  // Freno en vivo: si las imágenes del tramo que viene (~1,2 s) aún no llegan, se avanza a la velocidad segura.
  function velocidad(posicion: number, sentido: number) {
    const deseada = velocidadEquipo();
    const listos = secuencia.descargadosDesde(posicion, Math.ceil(deseada * 1.2), sentido);
    if (listos >= Math.ceil(deseada * 1.2)) return deseada;
    return listos >= 20 ? LENTA : 25;
  }

  const reproductor = new Reproductor({
    total,
    aScroll,
    indiceActual: () => disparador.progress * (total - 1),
    escenas,
    pausas: conProductos,
    velocidad,
    alMover: () => ScrollTrigger.update(),
    alCambiarEstado: (estado) => {
      botonPlay.dataset.estado = estado;
      const enPlay = estado === 'reproduciendo';
      botonPlay.setAttribute('aria-label', enPlay ? 'Pausar el recorrido' : 'Reproducir el recorrido');
      tituloPlay.textContent = enPlay ? 'Pausar' : 'Reproducir recorrido';
      ayudaPlay.textContent = enPlay ? 'desliza cuando quieras para tomar el control' : 'o desliza para explorarlo a tu ritmo';
    },
  });

  if (new URLSearchParams(location.search).has('fps')) (window as unknown as { reproductorRecorrido: Reproductor }).reproductorRecorrido = reproductor;

  botonPlay.addEventListener('click', () => (reproductor.estado === 'reproduciendo' ? reproductor.detener() : reproductor.reproducir()));
  anterior.addEventListener('click', () => reproductor.irA(-1));
  siguiente.addEventListener('click', () => reproductor.irA(1));

  // Flechas desactivadas en los extremos del recorrido
  function actualizarFlechas(indice: number) {
    anterior.disabled = indice <= escenas[0] + 0.5;
    siguiente.disabled = indice >= escenas[escenas.length - 1] - 0.5;
  }
  ScrollTrigger.create({ trigger: seccion, start: 'top top', end: 'bottom bottom', onUpdate: ({ progress }) => actualizarFlechas(progress * (total - 1)) });
  actualizarFlechas(0);

  // Saltar a una escena: se desplaza hasta el centro de su rango de frames.
  for (const b of botones) {
    b.addEventListener('click', () => {
      reproductor.detener();
      const t = tarjetas.find((x) => x.dataset.parada === b.dataset.irA)!;
      const medio = (Number(t.dataset.desde) + Number(t.dataset.hasta)) / 2;
      const y = disparador.start + ((medio - 1) / (total - 1)) * (disparador.end - disparador.start);
      window.scrollTo({ top: y, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  }
</script>
